<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="dual_pa10">

  <!-- Shared world link -->
  <link name="world"/>

  <link name="base_link"/>
  <joint name="base_to_world" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
  </joint>
  <!-- Include PA10 macro -->
  <xacro:include filename="$(find manipulatorws)/urdf/pa10.urdf.xacro"/>

  <!-- Left arm at origin -->
  <xacro:pa10_arm prefix="left_" parent="base_link" xyz="0 0 0" rpy="0 0 0"/>

  <!-- Right arm offset 1.5m in x dir -->
  <xacro:pa10_arm prefix="right_" parent="base_link" xyz="1.5 0 0" rpy="0 0 0"/>

  <!--Top arm offset 1.5m in y dir-->
  <!--xacro:pa10_arm prefix="top_" parent="base_link" xyz="0.75 1.5 0" rpy="0 0 0"/-->


</robot>
